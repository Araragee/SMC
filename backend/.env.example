# Copy this file to .env and fill in real values before starting the app.
# Never commit the real .env to version control.

SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Default admin account (created automatically on first boot if no admin exists)
DEFAULT_ADMIN_PASSWORD=changeme_on_first_boot
DEFAULT_ADMIN_EMAIL=admin@smc.edu
DEFAULT_ADMIN_USERNAME=admin

# Database. Leave unset for dev SQLite fallback.
# DATABASE_URL=postgresql+psycopg2://smc:password@localhost:5432/smc
# DATABASE_URL=sqlite:///./sql_app.db
# CockroachDB Cloud (Postgres wire protocol — no code changes needed).
# Copy the connection string from the cluster's "Connect" dialog, swap the
# postgresql:// scheme for postgresql+psycopg2:// and keep sslmode=verify-full.
# DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:26257/<db>?sslmode=verify-full

# Postgres (used by docker-compose). Required when running compose.
POSTGRES_DB=smc
POSTGRES_USER=smc
POSTGRES_PASSWORD=replace-me

# Notifier: console (default, log only) or email (SMTP_* required)
NOTIFIER_TYPE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@smc.local

# Push notifications (VAPID). Generate via `python scripts/gen_vapid.py`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@smc.edu

# Upload storage directory (mount a volume here when using local disk)
UPLOADS_DIR=uploads

# Object storage for uploads. Set all three to store files in a private
# Supabase Storage bucket instead of local disk — required on hosts with an
# ephemeral filesystem (Render free tier) or more than one replica.
# The service key bypasses row-level security: server-side only, never in the
# frontend bundle.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=uploads

# Demo data. seed.py creates accounts with published passwords — leave this
# false anywhere reachable from the internet.
SEED_DEMO_DATA=false

# Browser origins allowed to call this API. JSON list; must include the
# frontend's real origin in production or every request is blocked by CORS.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Refresh-token cookie. MUST be true when served over HTTPS, otherwise the
# refresh token is sent over plaintext connections.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Diagnostic endpoints. Never true in production.
DEBUG=false
